---
// Case-study / blog-post page — Kedar's design "MacBook Air - 32" (2026-11-04). White, full viewport width:
//   title, × (back to /work) top right → PostIntro (project details) → the Markdown body, exactly in Notion's order
//   (images edge to edge) → one button, "Impressed? Let’s talk" (→ /contact; Kedar, 2026-11-01)
//   → "Next post": the next post's /work card. The /work card graphic isn't shown on the post itself.
//   Floating ↑ (to top) appears once the top × scrolls away; it jumps (no smooth scroll — Motion rules).
// Used by src/pages/work/[slug].astro and by Markdown pages (`layout:` frontmatter, e.g. /styleguide).
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Actions from '../components/Actions.astro';
import PostIntro, { type Details } from '../components/PostIntro.astro';
import PostCard from '../components/PostCard.astro';
import type { CollectionEntry } from 'astro:content';
import { routes, labels, path } from '../data/site';
import { ids, canonicalFor } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  publishedDate?: Date;
  updatedDate?: Date;
  /** Not shown; goes into the article's structured data (timeRequired). */
  readMinutes?: number;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Project details panel; absent on Markdown pages such as /styleguide. */
  details?: Details;
  noindex?: boolean;
  /** The post after this one in Notion's Order (wraps to the first); shown under the CTA as its /work card. */
  next?: CollectionEntry<'work'>;
  /** False for a post not written yet: no white sheet. */
  hasBody?: boolean;
  /** Present when used as a Markdown page layout. */
  frontmatter?: Omit<Props, 'frontmatter'>;
}
const props = Astro.props.frontmatter ? { ...Astro.props.frontmatter, ...Astro.props } : Astro.props;
const { title, description, readMinutes, ogImage, ogImageAlt, details, next, noindex = false, hasBody = true } = props;
const publishedDate = props.publishedDate ? new Date(props.publishedDate) : undefined;
const updatedDate = props.updatedDate ? new Date(props.updatedDate) : undefined;

const origin = Astro.site ?? new URL(Astro.url.origin);
const url = canonicalFor(Astro.url.pathname, origin);
const id = ids(origin);

const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: title,
    ...(description ? { description } : {}),
    url,
    mainEntityOfPage: url,
    inLanguage: 'en',
    author: { '@id': id.founder },
    publisher: { '@id': id.org },
    isPartOf: { '@id': id.website },
    ...(publishedDate ? { datePublished: publishedDate.toISOString() } : {}),
    ...(updatedDate || publishedDate ? { dateModified: (updatedDate ?? publishedDate)!.toISOString() } : {}),
    ...(readMinutes ? { timeRequired: `PT${readMinutes}M` } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Work', item: new URL(`${routes.workList}/`, origin).href },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={ogImageAlt}
  type="article"
  publishedDate={publishedDate}
  updatedDate={updatedDate}
  noindex={noindex}
  jsonLd={jsonLd}
  postTitle={hasBody ? title : undefined}
>
  <article class="post on-surface">
    <a class="back" href={routes.workList} aria-label={labels.back}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </a>

    <header class="hero container">
      <h1 class="t-h1 title">{title}</h1>
    </header>

    {hasBody && details && <div class="details container"><PostIntro details={details} /></div>}

    {hasBody && (
      <div class="sheet">
        <div class="prose">
          <slot />
        </div>
      </div>
    )}

    <div class="end container">
      <Actions primary={{ label: labels.impressedTalk, href: routes.contact }} />
    </div>

    {next && (
      <nav class="next container" aria-labelledby="next-post">
        <h2 id="next-post" class="t-p next-label">{labels.nextPost}</h2>
        <PostCard post={next} href={routes.work(next.id)} />
      </nav>
    )}
  </article>

  <div class="float" data-float hidden>
    <a class="float-button" href="#top" aria-label={labels.toTop} data-to-top>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 15l6-6 6 6" />
      </svg>
    </a>
  </div>
</BaseLayout>

<script>
  // Floating to-top: shown only while the top × is out of view.
  const float = document.querySelector<HTMLElement>('[data-float]');
  const topBack = document.querySelector<HTMLElement>('.post .back');
  if (float && topBack) {
    new IntersectionObserver(([entry]) => { float.hidden = entry.isIntersecting; }).observe(topBack);
    float.querySelector('[data-to-top]')?.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0 });
      topBack.focus({ preventScroll: true }); // keyboard users land at the top too
    });
  }
</script>

<style>
  .post {
    position: relative;
    flex: 1;
    padding-bottom: var(--rhythm-section);
    background: var(--color-surface);
  }

  /* × top right, scrolls with the page. Phones: the title starts under it. */
  .back {
    position: absolute;
    top: var(--rhythm-post-close);
    right: var(--rhythm-gutter);
    display: grid;
    place-items: center;
    width: var(--size-cue);
    height: var(--size-cue);
    border-radius: var(--radius-pill);
    background: var(--color-button);
    color: var(--color-on-button);
  }
  .back:hover { background: var(--color-button-hover); }
  .back svg { width: var(--size-cue-icon); height: var(--size-cue-icon); }

  .hero {
    padding-top: calc(var(--rhythm-post-close) + var(--size-cue) + var(--rhythm-post-close));
  }
  .title { text-align: var(--align-page); }
  .details { margin-top: var(--rhythm-post-top); }
  @media (min-width: 48rem) {
    .hero { padding-top: var(--rhythm-post-hero); }
    .details { margin-top: var(--rhythm-post-title); }
    /* On the frame's 940 grid; on narrower screens it stays clear of the ×. */
    .title { max-width: min(var(--width-post-details), 100% - 2 * (var(--size-cue) + var(--rhythm-gutter))); margin-inline: auto; }
  }

  .sheet { margin-top: var(--rhythm-post-body); }
  /* A body that starts with an image sits closer to the details (MacBook Air - 32). */
  .sheet:has(> .prose > :global(figure:first-child)) { margin-top: var(--rhythm-post-top); }

  /* Next post (Kedar, 2026-11-01): its /work card, under the CTA. */
  .next {
    display: grid;
    gap: var(--rhythm-stack);
    margin-top: var(--rhythm-section);
  }
  .next-label { text-align: var(--align-page); }

  .end {
    display: grid;
    justify-items: center;
    margin-top: var(--rhythm-hero-to-content);
  }

  /* Floating to-top: bottom-right, same black circle as the top ×. */
  .float {
    position: fixed;
    right: var(--rhythm-gutter);
    bottom: var(--rhythm-float);
    z-index: var(--z-float);
    display: grid;
    gap: var(--rhythm-action-pair);
  }
  .float[hidden] { display: none; }
  .float-button {
    display: grid;
    place-items: center;
    width: var(--size-cue);
    height: var(--size-cue);
    border-radius: var(--radius-pill);
    background: var(--color-button);
    color: var(--color-on-button);
    box-shadow: var(--shadow-raised);
  }
  .float-button:hover { background: var(--color-button-hover); }
  .float-button svg { width: var(--size-cue-icon); height: var(--size-cue-icon); }

</style>
