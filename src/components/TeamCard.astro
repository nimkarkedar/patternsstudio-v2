---
// About page: one team member or advisor. Everything on the card, nothing to click open (Kedar, 2026-11-06: replaces the
// flip + bio modal, so people just read). White card: name (P-Bold) + role (Small, grey) and the LinkedIn mark, then the
// bio (opens with the name in bold), portrait standing on the bottom edge.
// Phones: text, then the portrait under it. From 48rem: portrait on the left (300 wide), text beside it.
// Photos: src/assets/about/*.webp, cropped from the frame. Tilts like every card except /work.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { labels } from '../data/site';

interface Props {
  name: string;
  role: string;
  photo?: ImageMetadata;
  alt?: string;
  linkedin?: string;
  bio: string;
}
const { name, role, photo, alt = '', linkedin, bio } = Astro.props;
// The bio opens with the person's name in bold (full name, or first name if that's how it starts).
const opening = [name, name.split(' ')[0]].find((n) => bio.startsWith(n)) ?? '';
const rest = bio.slice(opening.length);
// Kedar's Linked-in.svg (2026-10-30).
const linkedinPath = 'M22.2234 0H1.77187C0.792187 0 0 0.773438 0 1.72969V22.2656C0 23.2219 0.792187 24 1.77187 24H22.2234C23.2031 24 24 23.2219 24 22.2703V1.72969C24 0.773438 23.2031 0 22.2234 0ZM7.12031 20.4516H3.55781V8.99531H7.12031V20.4516ZM5.33906 7.43438C4.19531 7.43438 3.27188 6.51094 3.27188 5.37187C3.27188 4.23281 4.19531 3.30937 5.33906 3.30937C6.47813 3.30937 7.40156 4.23281 7.40156 5.37187C7.40156 6.50625 6.47813 7.43438 5.33906 7.43438ZM20.4516 20.4516H16.8937V14.8828C16.8937 13.5562 16.8703 11.8453 15.0422 11.8453C13.1906 11.8453 12.9094 13.2937 12.9094 14.7891V20.4516H9.35625V8.99531H12.7687V10.5609H12.8156C13.2891 9.66094 14.4516 8.70938 16.1813 8.70938C19.7859 8.70938 20.4516 11.0813 20.4516 14.1656V20.4516Z';
---
<article class="card on-surface" data-tilt>
  <div class="text">
    <header class="person">
      <div class="who">
        <h3 class="t-p-bold">{name}</h3>
        <p class="t-small role">{role}</p>
      </div>
      {linkedin && (
        <a class="linkedin" href={linkedin} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={linkedinPath} /></svg>
          <span class="visually-hidden">{name} {labels.onLinkedIn}</span>
        </a>
      )}
    </header>
    <p class="t-p bio">{opening && <strong class="t-p-bold">{opening}</strong>}{rest}</p>
  </div>
  {photo && <Image src={photo} alt={alt} class="photo" widths={[400, 800, 1200]} sizes="(min-width: 48rem) 300px, 100vw" />}
</article>

<script>
  import '../scripts/tilt';
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-on-surface);
    box-shadow: var(--shadow-glow);
    transform: perspective(var(--motion-tilt-depth)) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
  }
  .text { display: grid; align-content: start; gap: var(--rhythm-stack); padding: var(--rhythm-team-pad); }
  .person { display: flex; justify-content: space-between; align-items: start; gap: var(--rhythm-list); }
  .who { display: grid; gap: var(--rhythm-label); }
  .role { color: var(--color-on-surface-muted); }
  .linkedin { position: relative; flex: none; }
  .linkedin::after { content: ''; position: absolute; inset: var(--rhythm-hit); } /* thumb-sized tap area */
  .linkedin svg { display: block; width: var(--size-team-icon); height: var(--size-team-icon); }
  .linkedin:hover { color: var(--color-linkedin); }
  .photo { width: 100%; height: auto; aspect-ratio: var(--ratio-team-photo); object-fit: cover; object-position: bottom; margin-top: auto; }

  @media (min-width: 48rem) {
    .card { flex-direction: row; }
    .photo { order: -1; flex: none; width: var(--width-team-card); align-self: flex-end; }
    .text { flex: 1; padding: var(--rhythm-card-pad); }
    .bio { max-width: var(--width-lead); }
  }
</style>
