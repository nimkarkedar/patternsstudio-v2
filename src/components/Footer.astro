---
// Footer: company, Singapore (flag + the word, Kedar 2026-11-15), UEN, and the studio's LinkedIn mark (Kedar 2026-11-15).
import { site, labels } from '../data/site';
import { linkedinPath } from '../icons/linkedin';
---
<footer class="footer">
  <p class="t-small">
    {site.legal}
    <span class="dot" aria-hidden="true">·</span>
    <span><span aria-hidden="true">{site.flag}</span> {site.locality}</span>
    <span class="dot" aria-hidden="true">·</span> {site.uen}
    <a class="linkedin" href={site.linkedin} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={linkedinPath} /></svg>
      <span class="visually-hidden">{labels.studioOnLinkedIn} ({labels.newTab})</span>
    </a>
  </p>
</footer>

<style>
  .footer {
    margin-top: auto;
    margin-inline: var(--rhythm-gutter);
    padding-block: var(--rhythm-footer);
    border-top: var(--line-width) solid var(--color-line-on-page);
    color: var(--color-on-page-muted);
    text-align: var(--align-page);
  }
  .footer p { display: inline-flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; justify-content: var(--align-page); }
  .dot { display: none; } /* phones: the parts wrap onto their own lines */
  .linkedin { position: relative; flex: none; }
  .linkedin::after { content: ''; position: absolute; inset: var(--rhythm-hit); } /* thumb-sized tap area */
  .linkedin svg { display: block; width: var(--size-footer-icon); height: var(--size-footer-icon); }
  .linkedin:hover { color: var(--color-on-page); }
  @media (min-width: 48rem) { .dot { display: inline; } }
</style>
