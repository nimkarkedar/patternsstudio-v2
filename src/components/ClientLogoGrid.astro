---
// /reviews: grid of every client logo (Kedar, 2026-10-30; MacBook Air - 33, 2026-11-04). Static — no motion.
// Logo files are white on page-blue tiles (400 × 150, padding built in), so they sit straight on the page, no card;
// slightly see-through, so they stay quieter than the headings around them.
// An invisible grid with room to breathe (Kedar, 2026-11-05; no lines): 4 per row ≥48rem, 2 on phones.
// Names render as text until a file exists.
// Same files + list as the scrolling strip on /work (ClientLogos): src/assets/clients/<file>, `clients` in site.ts.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { clients } from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/clients/*.{svg,png,webp}', { eager: true });
const logoFor = (file: string) =>
  Object.entries(files).find(([path]) => path.split('/').pop()?.replace(/\.\w+$/, '') === file)?.[1].default;
---
<section class="logos" aria-label="Clients">
  <ul role="list" class="grid">
    {clients.map((c) => {
      const logo = logoFor(c.file);
      return (
        <li class="item">
          {logo
            ? <Image src={logo} alt={c.name} class="logo" widths={[160, 320]} sizes="160px" />
            : <span class="t-p-bold">{c.name}</span>}
        </li>
      );
    })}
  </ul>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--rhythm-logo-grid-row) var(--grid-gutter);
  }
  .item {
    display: grid;
    place-items: center;
    color: var(--color-on-page);
    text-align: center;
  }
  .logo { width: 100%; max-width: var(--width-client-logo-grid); height: auto; opacity: var(--opacity-client-logo); }

  @media (min-width: 48rem) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
