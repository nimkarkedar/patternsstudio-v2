---
// Project details at the top of a post (Kedar's design, MacBook Air - 32, 2026-11-04): a pale-blue panel with three
// columns: short values stacked (Client, Industry, Status), then Scope, then the long values (Client testimonial, Impact).
// Small grey label over a P-Bold value; lists are plain lines. One column on phones.

interface Fact { label: string; value: string | string[]; href?: string }
interface Props { facts?: Fact[] }
const { facts = [] } = Astro.props;

const WIDE = 32; // characters — a longer value leaves the first column
const points = (f: Fact) => (Array.isArray(f.value) ? f.value.filter(Boolean) : [f.value]);
const shown = (f: Fact) => {
  const text = points(f).join(' ');
  return f.href ? text.replace(/^https?:\/\//, '').replace(/\/$/, '') : text;
};
const isLong = (f: Fact) => points(f).length > 1 || shown(f).length > WIDE;
const columns = [
  facts.filter((f) => !isLong(f)),
  facts.filter((f) => isLong(f) && f.label === 'Scope'),
  facts.filter((f) => isLong(f) && f.label !== 'Scope'),
].filter((c) => c.length > 0);
---
{facts.length > 0 && (
  <dl class="facts">
    {columns.map((column) => (
      <div class="column">
        {column.map((f) => (
          <div class="fact">
            <dt class="t-small label">{f.label}</dt>
            <dd class="t-p-bold">
              {points(f).length > 1
                ? <ul class="points" role="list">{points(f).map((p) => <li>{p}</li>)}</ul>
                : f.href ? <a href={f.href} rel="noopener" target="_blank">{shown(f)}</a> : shown(f)}
            </dd>
          </div>
        ))}
      </div>
    ))}
  </dl>
)}

<style>
  .facts {
    display: grid;
    gap: var(--rhythm-intro-row);
    padding: var(--rhythm-facts-pad);
    border-radius: var(--radius-card);
    background: var(--color-surface-tint);
    color: var(--color-on-surface);
  }
  .column { display: grid; align-content: start; gap: var(--rhythm-intro-row); }
  .fact { display: grid; gap: var(--rhythm-label); }
  .label { color: var(--color-on-surface-muted); }
  .points { display: grid; }
  a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--underline-width);
    text-underline-offset: var(--underline-offset);
  }
  a:hover { color: var(--color-on-surface); }

  @media (min-width: 48rem) {
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--grid-gutter); }
  }
</style>
