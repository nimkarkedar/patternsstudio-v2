---
// Services (Kedar's design, MacBook Air - 30, 2026-11-04): hero, problem → probable solution table,
// "In other words, we do" + service grid. The frame repeats one service as a placeholder; the six services stay as they were.
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../data/seo';
import Hero from '../components/Hero.astro';
import Actions from '../components/Actions.astro';
import ProblemList from '../components/ProblemList.astro';
import IconGrid from '../components/IconGrid.astro';
import { routes, labels } from '../data/site';

// Kedar's words, verbatim (typos stay until he fixes them).
const problems = [
  { problem: 'Because of AI, our product looks like every other product on the market.', solution: 'Design system + brand identity', icon: 'identity' },
  { problem: 'We have leaky funnels, slow adoption and low conversion.', solution: 'UI and UX optimisation + storytelling', icon: 'optimise' },
  { problem: 'We’ve grown too fast. Our product looks incoherent.', solution: 'Design system', icon: 'system' },
  { problem: 'Users and clients are unclear about what we offer.', solution: 'Product marketing + brand communication + storytelling', icon: 'marketing' },
  { problem: 'We want to adopt AI and grow.', solution: 'Design advisory', icon: 'advisory' },
];

const services = [
  { label: 'Brand and communication design', icon: 'brand' },
  { label: 'Product and experience design, with prototyping', icon: 'product' },
  { label: 'MVP and go-to-market design', icon: 'mvp' },
  { label: 'Growth and design advisory', icon: 'growth' },
  { label: 'AI transformation of your business', icon: 'ai' },
  { label: 'Workshops that level up teams and the C-suite', icon: 'workshops' },
];
---
<BaseLayout {...pageSeo.services}>
  <Hero
    title={['Different problems.', 'Familiar patterns.']}
    lead="We bring clarity, creativity and commercial thinking to move your business forward."
  >
    <Actions primary={{ label: labels.exploreWork, href: routes.workList }} />
  </Hero>

  <div class="container page">
    <section aria-label="Problems we solve">
      <ProblemList items={problems} problemLabel="Problem / Situation" solutionLabel="Probable solution (we provide)" phoneLabel="Problem → Our solution" />
    </section>

    <section aria-labelledby="called">
      <h2 id="called" class="t-h2 heading">In other words, we do</h2>
      <IconGrid set="services" items={services} />
    </section>

    <div class="actions"><Actions primary={{ label: labels.exploreWork, href: routes.workList }} /></div>
  </div>
</BaseLayout>

<style>
  .page { padding-bottom: var(--rhythm-section); }
  .heading { text-align: var(--align-page); margin-block: var(--rhythm-heading-above) var(--rhythm-heading-below); }
  .actions { display: flex; justify-content: center; margin-top: var(--rhythm-page-actions); }
</style>
