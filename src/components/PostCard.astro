---
// Post card: Kedar's graphic at the link-preview ratio 1200:630 — the same image is the post's
// WhatsApp/LinkedIn/X preview. Without a graphic it's a plain white card of the same shape.
// Hover on the graphic = the approved Apple-style lift (CLAUDE.md, Motion item 4).
//
// `row` (the /work page, MacBook Air - 37, 2026-11-06): the post title + a small ghost "View details" button
// link on the left (5 of 12 columns), the graphic on the right (7 columns; Kedar 2026-11-06, the frame shows 4/8). Phones: graphic first,
// then title + link under it.
// Without `row` (Next post, end of every post): the graphic alone.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { labels } from '../data/site';
import Button from './Button.astro';

interface Props { post: CollectionEntry<'work'>; href: string; eager?: boolean; row?: boolean }
const { post, href, eager = false, row = false } = Astro.props;
const { data } = post;
---
<div class:list={['card', { row }]}>
  {row && (
    <div class="text">
      <h2 class="t-h2">{data.title}</h2>
      <Button href={href} variant="ghost" small data-sheet-link>{labels.viewDetails}<span class="visually-hidden">: {data.title}</span></Button>
    </div>
  )}
  {/* In a row the graphic repeats "View details", so it's kept out of the tab order and screen readers. */}
  <a class="item" href={href} tabindex={row ? -1 : undefined} aria-hidden={row ? 'true' : undefined} data-sheet-link={row ? '' : undefined}>
    <span class="post on-surface">
    {data.ogImage
      ? <Image
          class="image"
          src={data.ogImage}
          alt={row ? '' : (data.ogImageAlt ?? data.title)}
          widths={[480, 720, 1120, 1600, 2240]}
          sizes={row ? '(min-width: 48rem) 58vw, 100vw' : '(min-width: 64rem) 1120px, 100vw'}
          loading={eager ? 'eager' : 'lazy'}
        />
      : null}
    </span>
  </a>
</div>

<style>
  .row { display: grid; gap: var(--rhythm-work-text); }
  .text { display: grid; gap: var(--rhythm-work-title); justify-items: start; order: 1; }

  .item { display: block; }
  .post {
    display: block;
    aspect-ratio: var(--ratio-cover);
    background: var(--color-surface);
    border-radius: var(--radius-post-card);
    overflow: hidden;
    box-shadow: var(--shadow-glow), var(--shadow-rest);
    transition:
      transform var(--motion-lift) var(--ease-lift),
      box-shadow var(--motion-lift) var(--ease-lift);
  }
  .image { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 48rem) {
    .row { grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr)); column-gap: var(--grid-gutter); }
    .row .text { grid-column: span 5; order: 0; align-self: start; padding-top: var(--rhythm-card-pad); }
    .row .item { grid-column: span 7; }
  }

  @media (hover: hover) {
    .card:hover .post, .card:focus-within .post {
      transform: translateY(var(--motion-lift-y)) scale(var(--motion-lift-scale));
      box-shadow: var(--shadow-glow), var(--shadow-lifted);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post { transition: none; }
    .card:hover .post, .card:focus-within .post { transform: none; }
  }
</style>
