---
// Primary pill button + optional ghost button beneath it (heroes and statements).
// Both buttons are always the same width:
//   phone   → both span the content width
//   ≥48rem  → both match the wider label (+ --rhythm-button-x padding each side)
import Button from './Button.astro';

interface Link { label: string; href: string; external?: boolean }
interface Props { primary: Link; secondary?: Link }
const { primary, secondary } = Astro.props;
---
<div class="actions">
  <Button href={primary.href} external={primary.external} fill>{primary.label}</Button>
  {secondary && <Button href={secondary.href} variant="ghost" external={secondary.external} fill>{secondary.label}</Button>}
</div>

<style>
  .actions {
    display: grid;
    gap: var(--rhythm-action-pair);
    width: 100%;
  }
  @media (min-width: 48rem) {
    .actions { width: max-content; }
  }
</style>
