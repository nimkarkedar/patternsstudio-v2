---
// /work card (Kedar, 2026-11-01): just Kedar's graphic, full content width, at the link-preview ratio
// (1200:630) — the same image is the post's cover and its WhatsApp/LinkedIn/X preview. No live text,
// no arrow: the graphic is the whole card. Without a graphic it's a plain white card of the same shape.
// Hover = the approved Apple-style lift (CLAUDE.md, Motion item 4).
// No title under the card (MacBook Air - 31, 2026-11-04).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'work'>; href: string; eager?: boolean }
const { post, href, eager = false } = Astro.props;
const { data } = post;
---
<a class="item" href={href}>
  <span class="post on-surface">
  {data.ogImage
    ? <Image
        class="image"
        src={data.ogImage}
        alt={data.ogImageAlt ?? data.title ?? data.brand}
        widths={[480, 720, 1120, 1600, 2240]}
        sizes="(min-width: 64rem) 1120px, 100vw"
        loading={eager ? 'eager' : 'lazy'}
      />
    : null}
  </span>
</a>

<style>
  .item { display: block; }
  .post {
    display: block;
    aspect-ratio: var(--ratio-cover);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-glow), var(--shadow-rest);
    transition:
      transform var(--motion-lift) var(--ease-lift),
      box-shadow var(--motion-lift) var(--ease-lift);
  }
  .image { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (hover: hover) {
    .item:hover .post, .item:focus-visible .post {
      transform: translateY(var(--motion-lift-y)) scale(var(--motion-lift-scale));
      box-shadow: var(--shadow-glow), var(--shadow-lifted);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post { transition: none; }
    .item:hover .post, .item:focus-visible .post { transform: none; }
  }
</style>
