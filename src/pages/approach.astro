---
// Approach (Kedar's design, MacBook Air - 35, 2026-11-06): hero, the 9-cell "what you can expect" grid, "There are 2 ways of
// working with us" (one card: Playing Jazz | Conducting a Symphony, then a row linking the client questionnaire), and a line
// linking the rate card (/rate-card, MacBook Air - 36). Kedar's words, verbatim (typos stay until he fixes them).
// The frame's grey circles mark where icons go; Claude picked them (Phosphor Regular, like the grid).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import IconGrid from '../components/IconGrid.astro';
import Card from '../components/Card.astro';
import { routes, brief } from '../data/site';
import jazzIcon from '../icons/ways/music-notes.svg?raw';
import symphonyIcon from '../icons/ways/metronome.svg?raw';

const expect = [
  { label: 'Senior hands only. That too hands-on.', icon: 'senior' },
  { label: 'No padded decks & stickies. Actual prototypes and visuals.', icon: 'prototypes' },
  { label: 'WCGA complaint. We take accessibility seriously', icon: 'accessible' },
  { label: 'Deep care about craft. Acute attention to detail.', icon: 'craft' },
  { label: 'Long lasting. Highly robust and commercially solid.', icon: 'robust' },
  { label: 'Output thats tangibly measurable.', icon: 'measurable' },
  { label: 'Deliverables that you can proudly own and keep using.', icon: 'deliverables' },
  { label: 'Systems that can run without us in the world of AI.', icon: 'systems' },
  { label: 'Fun and creative people whom you would love working with', icon: 'fun' },
];

const ways = [
  {
    icon: jazzIcon,
    name: 'Playing Jazz',
    promise: 'When things are predictable, we bring creative improvisation.',
    text: 'Works best when you’ve have a great product market fit and now trying to scale. Design for growth.',
  },
  {
    icon: symphonyIcon,
    name: 'Conducting a Symphony',
    promise: 'When things are uncertain, we bring clarity, direction and purpose.',
    text: 'Idea for startups who have grown too fast. Have tested your MVP and now wish to bring order.',
  },
];
---
<BaseLayout title="Approach" description="We know when to re-invent the wheel. We make sure your users and clients love you. We are eclectic, non-hierarchical first principle thinkers.">
  <Hero
    title={['We know when to', 're-invent the wheel']}
    lead="We make sure your users and clients love you. We are eclectic, non-hierarchical first principle thinkers."
  />

  <div class="container page">
    <IconGrid set="approach" items={expect} />

    <section aria-labelledby="ways">
      <h2 id="ways" class="t-h2 heading">There are 2 <br />ways of working with us</h2>
      <Card tilt>
        <div class="ways">
          {ways.map((way) => (
            <div class="way">
              <span class="icon glyph" aria-hidden="true" set:html={way.icon} />
              <h3 class="t-p-bold">{way.name}</h3>
              <p class="t-p">{way.promise} {way.text}</p>
            </div>
          ))}
        </div>
        <div class="questions">
          <p class="t-p-bold">We’ve made a questionnaire to get things started.</p>
          <a class="t-p link" href={brief.doc} target="_blank" rel="noopener">Questions we ask clients</a>
        </div>
      </Card>
    </section>

    <p class="t-p rate">We also have a <a class="link" href={routes.rateCard}>rate card</a> for clients who know it all</p>
  </div>
</BaseLayout>

<style>
  .page { padding-bottom: var(--rhythm-section); }
  .heading { text-align: var(--align-page); margin-block: var(--rhythm-heading-above) var(--rhythm-heading-below); }
  .heading br { display: none; }

  /* The hairlines are the background showing through a 1px gap, as in IconGrid. */
  .ways { display: grid; gap: var(--line-width); background: var(--color-line-on-surface); }
  .way {
    display: grid;
    align-content: start;
    gap: var(--rhythm-stack);
    padding: var(--rhythm-icon-cell);
    background: var(--color-surface);
  }
  .icon { color: var(--color-service-icon); }
  .icon :global(svg) {
    display: block;
    width: var(--size-service-icon);
    height: var(--size-service-icon);
    fill: currentColor;
  }

  .questions {
    display: grid;
    gap: var(--rhythm-stack);
    padding: var(--rhythm-icon-cell);
    border-top: var(--line-width) solid var(--color-line-on-surface);
  }
  .link { text-decoration: underline; justify-self: start; }

  .rate { margin-top: var(--rhythm-page-actions); text-align: var(--align-page); }

  @media (min-width: 48rem) {
    .heading br { display: inline; }
    .ways { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .questions { grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; }
  }
</style>
