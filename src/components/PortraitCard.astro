---
// Portrait card (Approach page, MacBook Air - 24): cut-out photo on one side with the person's name + role over it,
// heading + text on the other. Phones: photo on top, big heading under it. Not a link.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Card from './Card.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  name: string;
  role: string;
  heading: string;
  side?: 'left' | 'right'; // photo side on desktop
  tilt?: boolean;
}
const { image, alt, name, role, heading, side = 'left', tilt = false } = Astro.props;
---
<Card tilt={tilt}>
  <div class:list={['portrait', `photo-${side}`]}>
    <figure class="photo">
      <Image src={image} alt={alt} widths={[480, 720, 960]} sizes="(min-width: 48rem) 490px, 100vw" />
      <figcaption class="label">
        <span class="t-p-bold">{name}</span>
        <span class="t-p">{role}</span>
      </figcaption>
    </figure>
    <div class="body">
      <h2 class="t-card-title">{heading}</h2>
      <p class="t-p"><slot /></p>
    </div>
  </div>
</Card>

<style>
  .portrait { display: flex; flex-direction: column; }
  .photo { position: relative; }
  .photo :global(img) { width: 100%; height: auto; }
  /* Label over the photo, white on the dark clothing. */
  .label {
    position: absolute;
    left: var(--rhythm-portrait-label-left);
    bottom: var(--rhythm-panel);
    right: var(--rhythm-card-pad); /* long roles wrap instead of running off the card */
    display: flex;
    flex-direction: column;
    color: var(--color-on-button);
  }
  .photo-right .label { left: auto; right: var(--rhythm-portrait-label-inset); }
  .body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--rhythm-stack);
    padding: var(--rhythm-card-pad);
  }

  @media (min-width: 48rem) {
    .portrait { flex-direction: row; align-items: stretch; }
    .photo { flex: none; align-self: flex-end; }
    .photo :global(img) { width: auto; height: var(--size-portrait-h); }
    .photo-right .label { left: var(--rhythm-portrait-label-right); right: var(--rhythm-card-pad); }
    .body { flex: 1; align-items: center; }
    .body > :global(*) { width: min(100%, var(--width-portrait-text)); }
    .photo-right .photo { order: 1; }
  }
</style>
