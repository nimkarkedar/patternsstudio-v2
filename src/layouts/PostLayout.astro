---
// Case-study / blog-post page — Kedar's design "MacBook Air - 11" (2026-10-16).
//   On the blue page: back button + title (title starts on grid column 2)
//   → cover card (= the link-preview image, 1200×630 ratio) → white sheet with the Markdown body
//   → "Impressed? See all work" / "Connect anytime".
//   Images in the body open larger in a lightbox (<dialog>, no animation).
// Used by src/pages/work/[slug].astro and by Markdown pages (`layout:` frontmatter, e.g. /styleguide).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Actions from '../components/Actions.astro';
import { routes, labels, path } from '../data/site';
import { ids, canonicalFor } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  publishedDate?: Date;
  updatedDate?: Date;
  /** Not shown; goes into the article's structured data (timeRequired). */
  readMinutes?: number;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Hero image. ImageMetadata from a post, or a /public path from a Markdown page. */
  cover?: ImageMetadata | string;
  coverAlt?: string;
  noindex?: boolean;
  /** False for a post not written yet: no white sheet. */
  hasBody?: boolean;
  /** Present when used as a Markdown page layout. */
  frontmatter?: Omit<Props, 'frontmatter'>;
}
const props = Astro.props.frontmatter ? { ...Astro.props.frontmatter, ...Astro.props } : Astro.props;
const { title, description, readMinutes, ogImage, ogImageAlt, cover, coverAlt = '', noindex = false, hasBody = true } = props;
const publishedDate = props.publishedDate ? new Date(props.publishedDate) : undefined;
const updatedDate = props.updatedDate ? new Date(props.updatedDate) : undefined;

const origin = Astro.site ?? new URL(Astro.url.origin);
const url = canonicalFor(Astro.url.pathname, origin);
const id = ids(origin);

const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: title,
    ...(description ? { description } : {}),
    url,
    mainEntityOfPage: url,
    inLanguage: 'en',
    author: { '@id': id.founder },
    publisher: { '@id': id.org },
    isPartOf: { '@id': id.website },
    ...(publishedDate ? { datePublished: publishedDate.toISOString() } : {}),
    ...(updatedDate || publishedDate ? { dateModified: (updatedDate ?? publishedDate)!.toISOString() } : {}),
    ...(readMinutes ? { timeRequired: `PT${readMinutes}M` } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Work', item: new URL(routes.home, origin).href },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={ogImageAlt}
  type="article"
  publishedDate={publishedDate}
  updatedDate={updatedDate}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <article class="post">
    <header class="hero container">
      <div class="title-row">
        <div class="back-slot">
          <a class="back" href={routes.home} aria-label={labels.back}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 6l-6 6 6 6" />
            </svg>
          </a>
        </div>
        <h1 class="t-title title">{title}</h1>
      </div>
      {cover && (
        <div class="cover">
          {typeof cover === 'string'
            ? <img src={cover.startsWith('/') ? path(cover) : cover} alt={coverAlt} />
            : <Image src={cover} alt={coverAlt} widths={[640, 960, 1440, 1880]} sizes="(min-width: 64rem) 940px, 100vw" loading="eager" fetchpriority="high" />}
        </div>
      )}
    </header>

    {hasBody && (
      <div class="container">
        <div class="sheet on-surface">
          <div class="prose">
            <slot />
          </div>
        </div>
      </div>
    )}

    <div class="end container">
      <Actions
        primary={{ label: labels.seeAllWork, href: routes.home }}
        secondary={{ label: labels.connectAnytime, href: routes.email }}
      />
    </div>
  </article>

  <dialog class="lightbox" aria-label={labels.enlarged}>
    <form method="dialog">
      <button class="lightbox-close" aria-label={labels.close}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </form>
  </dialog>
</BaseLayout>

<script>
  // Lightbox: any body image opens larger; Esc, the × button or a click outside the image closes it.
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  // The enlarged <img> is created on first open (an empty <img> would be invalid).
  const big = document.createElement('img');
  big.className = 'lightbox-image';
  if (dialog) {
    document.querySelectorAll<HTMLButtonElement>('.prose .zoom').forEach((button) => {
      button.addEventListener('click', () => {
        const img = button.querySelector('img');
        if (!img) return;
        if (!big.isConnected) dialog.prepend(big);
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog || e.target === big) dialog.close(); });
  }
</script>

<style>
  .post { padding-bottom: var(--rhythm-section); }

  .hero {
    display: grid;
    gap: var(--rhythm-hero-to-content);
    padding-top: var(--rhythm-page-top);
    color: var(--color-on-page);
  }
  /* Back button in column 1, title from column 2 (Kedar's design). */
  .title-row {
    display: grid;
    grid-template-columns: var(--grid-column) minmax(0, 1fr);
    column-gap: var(--rhythm-back-gap);
    align-items: start;
  }
  .back-slot {
    display: grid;
    align-items: center;
    height: calc(var(--size-title) * var(--leading-snug)); /* centred on the title's first line */
  }
  .back {
    display: grid;
    place-items: center;
    width: var(--size-cue);
    height: var(--size-cue);
    border-radius: var(--radius-pill);
    background: var(--color-button);
    color: var(--color-on-button);
  }
  .back:hover { background: var(--color-button-hover); }
  .back svg { width: var(--size-cue-icon); height: var(--size-cue-icon); }
  .title { color: var(--color-on-page); }

  .cover {
    aspect-ratio: var(--ratio-cover);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-glow);
  }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .sheet {
    margin-top: var(--rhythm-card-gap);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-glow);
    padding: var(--rhythm-sheet-pad) var(--rhythm-sheet-x);
  }

  .end {
    display: grid;
    justify-items: center;
    margin-top: var(--rhythm-hero-to-content);
  }

  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: var(--rhythm-gutter);
    border: 0;
    background: transparent;
    z-index: var(--z-lightbox);
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: var(--color-lightbox); }
  .lightbox :global(.lightbox-image) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    object-fit: contain;
    border-radius: var(--radius-card);
    cursor: zoom-out;
  }
  .lightbox-close {
    position: fixed;
    top: var(--rhythm-gutter);
    right: var(--rhythm-gutter);
    display: grid;
    place-items: center;
    width: var(--size-cue);
    height: var(--size-cue);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-on-surface);
  }
  .lightbox-close svg { width: var(--size-cue-icon); height: var(--size-cue-icon); }
</style>
