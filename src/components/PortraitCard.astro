---
// Portrait card (Approach page, MacBook Air - 24): cut-out photo on one side; heading, text and a small grey credit
// (name + role, Kedar 2026-11-05: no more text over the photo) on the other. Phones: photo on top. Not a link.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Card from './Card.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  name: string;
  role: string;
  heading: string;
  side?: 'left' | 'right'; // photo side on desktop
  tilt?: boolean;
}
const { image, alt, name, role, heading, side = 'left', tilt = false } = Astro.props;
---
<Card tilt={tilt}>
  <div class:list={['portrait', `photo-${side}`]}>
    <div class="photo">
      <Image src={image} alt={alt} widths={[480, 720, 960]} sizes="(min-width: 48rem) 490px, 100vw" />
    </div>
    <div class="body">
      <h2 class="t-p-bold">{heading}</h2>
      <div class="t-p text"><slot /></div>
      <p class="t-small credit">{name}, {role}</p>
    </div>
  </div>
</Card>

<style>
  .portrait { display: flex; flex-direction: column; }
  .photo :global(img) { width: 100%; height: auto; }
  .credit { color: var(--color-on-surface-muted); }
  .text > :global(* + *) { margin-top: var(--rhythm-stack); } /* the text can be a few short paragraphs */
  .body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--rhythm-stack);
    padding: var(--rhythm-card-pad);
  }

  @media (min-width: 48rem) {
    .portrait { flex-direction: row; align-items: stretch; }
    .photo { flex: none; align-self: flex-end; }
    .photo :global(img) { width: auto; height: var(--size-portrait-h); }
    .body { flex: 1; align-items: center; }
    .body > :global(*) { width: min(100%, var(--width-portrait-text)); }
    .photo-right .photo { order: 1; }
  }
</style>
