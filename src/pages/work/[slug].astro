---
// Case-study page for every post. Posts without a written body yet are noindex (thin content)
// and are left out of the sitemap, RSS and llms.txt until Kedar writes them.
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { readingMinutes } from '../../lib/seo';

export async function getStaticPaths() {
  // Next post = the following one in Notion's Order, wrapping round to the first (none if there's only one).
  const posts = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts.length > 1 ? posts[(i + 1) % posts.length] : undefined },
  }));
}

const { post, next } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const written = Boolean(post.body?.trim());
---
<PostLayout
  title={data.title}
  description={data.description}
  publishedDate={data.publishedDate}
  updatedDate={data.updatedDate}
  readMinutes={written ? readingMinutes(post.body) : undefined}
  ogImage={data.ogImage}
  ogImageAlt={data.ogImageAlt}
  details={{ client: data.client, logo: data.logo, industry: data.industry, live: data.live, scope: data.scope, testimonial: data.testimonial, impact: data.impact }}
  next={next}
  noindex={!written}
  hasBody={written}
>
  <Content />
</PostLayout>
