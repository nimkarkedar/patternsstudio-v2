---
// Project details at the top of a post (Kedar, MacBook Air - 32, 2026-11-05). Four cells, white hairlines between:
// Client logo | Client name, Industry, Status | Scope | Client testimonial and Impact, which share the last cell.
// Each is one Notion column. Blank = not shown, and the cells left share the width.
// Small grey label over a P value. The logo has no visible label; testimonial and Impact carry an icon instead.
// Phones: a spec list, short values beside their label.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { labels } from '../data/site';
import testimonialIcon from '../icons/post/testimonial.svg?raw';
import impactIcon from '../icons/post/impact.svg?raw';

export interface Details {
  client?: string;
  logo?: ImageMetadata;
  industry?: string;
  live?: string;
  scope?: string[];
  testimonial?: string;
  impact?: string[];
}
interface Props { details: Details }
const { client, logo, industry, live, scope = [], testimonial, impact = [] } = Astro.props.details;
const liveText = live?.replace(/^https?:\/\//, '').replace(/\/$/, '');
const hasShort = Boolean(client || industry || live);
const hasLast = Boolean(testimonial) || impact.length > 0;
---
<dl class="facts">
  {logo && (
    <div class="column">
      <div class="fact">
        <dt class="visually-hidden">{labels.clientLogo}</dt>
        <dd><Image src={logo} alt={client ? `${client} logo` : labels.clientLogo} class="logo" /></dd>
      </div>
    </div>
  )}
  {hasShort && (
    <div class="column short">
      {client && <div class="fact"><dt class="t-small label">{labels.client}</dt><dd class="t-p">{client}</dd></div>}
      {industry && <div class="fact"><dt class="t-small label">{labels.industry}</dt><dd class="t-p">{industry}</dd></div>}
      {live && <div class="fact"><dt class="t-small label">{labels.status}</dt><dd class="t-p"><a href={live} rel="noopener" target="_blank">{liveText}</a></dd></div>}
    </div>
  )}
  {scope.length > 0 && (
    <div class="column">
      <div class="fact">
        <dt class="t-small label">{labels.scope}</dt>
        <dd class="t-p"><ul class="points">{scope.map((s) => <li>{s}</li>)}</ul></dd>
      </div>
    </div>
  )}
  {hasLast && (
    <div class="column">
      {testimonial && (
        <div class="fact">
          <dt class="icon"><span class="visually-hidden">{labels.testimonial}</span><Fragment set:html={testimonialIcon} /></dt>
          <dd class="t-p">{testimonial}</dd>
        </div>
      )}
      {impact.length > 0 && (
        <div class="fact">
          <dt class="icon"><span class="visually-hidden">{labels.impact}</span><Fragment set:html={impactIcon} /></dt>
          <dd class="t-p">{impact.length > 1 ? <ul class="points">{impact.map((p) => <li>{p}</li>)}</ul> : impact[0]}</dd>
        </div>
      )}
    </div>
  )}
</dl>

<style>
  /* Phones: a compact spec list in the pale panel, white lines between rows. Short values sit beside their label;
     Scope, Impact and other long values sit under it. */
  .facts {
    padding-inline: var(--rhythm-fact-x);
    border-radius: var(--radius-card);
    background: var(--color-surface-tint);
    color: var(--color-on-surface);
  }
  .column + .column, .fact + .fact { border-top: var(--line-width) solid var(--color-surface); }
  .fact { display: grid; gap: var(--rhythm-fact-label); padding-block: var(--rhythm-fact-y); }
  .short .fact {
    grid-template-columns: var(--width-fact-label) minmax(0, 1fr);
    column-gap: var(--rhythm-fact-gap);
    align-items: baseline;
  }
  .label { color: var(--color-on-surface-muted); }
  .logo { display: block; width: auto; max-width: 100%; height: var(--size-post-logo); }
  .icon { display: block; width: var(--size-fact-icon); height: var(--size-fact-icon); }
  .icon :global(svg) { display: block; width: 100%; height: 100%; }
  dd { overflow-wrap: anywhere; line-height: var(--leading-fact); }
  .points { padding-inline-start: var(--rhythm-fact-bullet); list-style: disc; }
  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: var(--underline-width);
    text-underline-offset: var(--underline-offset);
  }
  a:hover { color: var(--color-accent); }

  /* From 48rem: cells side by side, on the frame's 940 grid. */
  @media (min-width: 48rem) {
    .facts {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      max-width: var(--width-post-details);
      margin-inline: auto;
      padding: 0;
    }
    .column {
      display: grid;
      align-content: start;
      gap: var(--rhythm-fact-row);
      padding: var(--rhythm-fact-top) var(--rhythm-fact-x) var(--rhythm-fact-bottom);
    }
    .column:first-child { padding-inline-start: var(--rhythm-fact-first); }
    .column + .column { border-top: 0; border-inline-start: var(--line-width) solid var(--color-surface); }
    .fact + .fact { border-top: 0; }
    .fact { align-content: start; padding-block: 0; }
    .short .fact { grid-template-columns: minmax(0, 1fr); }
    .icon { margin-top: var(--rhythm-fact-icon-lift); }
  }
</style>
