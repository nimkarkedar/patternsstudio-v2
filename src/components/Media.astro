---
// Optimised image, or a clearly-labelled placeholder until the real asset is supplied.
// `fixed` locks the frame to --ratio-card-image (5:4) and crops the image to fill it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  /** Shown inside the placeholder box, e.g. "Samwoh image". */
  label: string;
  fixed?: boolean;
  sizes?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, label, fixed = false, sizes = '(min-width: 48rem) 470px, 100vw', class: className, eager = false } = Astro.props;
---
<div class:list={['media', { fixed }, className]}>
  {src ? (
    <Image src={src} alt={alt} widths={[480, 720, 960, 1440]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <div class="placeholder t-body" role="img" aria-label={alt}>
      <span>Image: {label}</span>
    </div>
  )}
</div>

<style>
  .media { overflow: hidden; }
  .media :global(img) { width: 100%; height: auto; }
  .placeholder {
    display: grid;
    place-items: center;
    padding: var(--space-4);
    text-align: center;
    background: var(--color-placeholder);
    color: var(--color-on-surface);
  }
  .fixed { aspect-ratio: var(--ratio-card-image); }
  .fixed :global(img), .fixed .placeholder { width: 100%; height: 100%; object-fit: cover; }
</style>
