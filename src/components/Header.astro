---
import Logo from './Logo.astro';
import { nav, contactLink, routes } from '../data/site';

const strip = (s: string) => s.replace(/\/$/, '');
const here = strip(Astro.url.pathname);
const isActive = (href: string) => here === strip(href) || here.startsWith(`${strip(href)}/`);
const links = [...nav, contactLink];
const { postTitle } = Astro.props as { postTitle?: string };
---
<header class="header" data-header data-post={postTitle ? '' : undefined}>
  <div class="bar">
    <a href={routes.home} class="home" aria-label="Patterns Studio — home"><Logo /></a>

    <nav class="nav" aria-label="Main">
      <ul role="list">
        {nav.map((l) => (
          <li><a class="t-nav link" href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    {postTitle && <a class="t-nav post-title" href="#top" tabindex="-1" aria-hidden="true">{postTitle}</a>}

    <a class="t-nav link contact" href={contactLink.href} aria-current={isActive(contactLink.href) ? 'page' : undefined}>{contactLink.label}</a>

    <button class="t-nav menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span data-label-closed>Menu</span><span data-label-open hidden>Close</span>
    </button>
  </div>

  {postTitle && <div class="progress" aria-hidden="true" data-progress></div>}

  <div class="sheet" id="mobile-menu" hidden data-menu>
    <ul role="list" class="sheet-links">
      {links.map((l) => (
        <li><a class="t-display sheet-link" href={l.href} aria-current={isActive(l.href) ? 'page' : undefined} data-menu-link>{l.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  /* Full-bleed: logo and Contact sit at the viewport edges (only the gutter between). Sticky. */
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    padding: var(--rhythm-header-y) var(--rhythm-gutter);
    background: var(--color-page);
    border-bottom: var(--line-width) solid transparent; /* reserved so the line never shifts layout */
    transition: border-bottom-color var(--motion-header-line) ease-out;
  }
  /* Soft line under the nav, faded in only while page content is passing beneath it (Kedar, 2026-10-15). */
  .header[data-covering] { border-bottom-color: var(--color-line-on-page); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--size-tap);
  }
  /* Reading progress: a white line along the bottom that fills as you read. */
  .progress {
    position: absolute;
    inset-inline: 0;
    bottom: calc(var(--line-width) * -1);
    height: var(--size-progress);
    background: var(--color-on-page);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }
  /* Post title takes the nav's place once the big title has gone under the header (≥48rem). */
  .post-title {
    display: none;
    color: var(--color-on-page);
    max-width: var(--width-header-title);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .home { display: inline-flex; position: relative; z-index: calc(var(--z-menu) + 1); }

  .nav, .contact { display: none; }

  .link {
    color: var(--color-on-page-muted);
  }
  .link:hover, .link[aria-current='page'], .contact { color: var(--color-on-page); }

  .menu-toggle {
    position: relative;
    z-index: calc(var(--z-menu) + 1);
    min-height: var(--size-tap);
    padding-inline: var(--space-2);
    margin-inline-end: calc(var(--space-2) * -1);
  }

  .sheet {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: var(--color-page);
    display: flex;
    align-items: flex-end;
    padding: var(--rhythm-gutter);
    padding-bottom: var(--rhythm-section);
  }
  .sheet[hidden] { display: none; }
  :global(html[data-menu-open]) { overflow: hidden; }
  .sheet-links { display: grid; gap: var(--space-2); }
  .sheet-link { color: var(--color-on-page-muted); display: inline-block; }
  .sheet-link[aria-current='page'] { color: var(--color-on-page); }

  @media (min-width: 48rem) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .nav { display: block; grid-area: 1 / 2; }
    /* Apple-style: the bar never moves; nav and post title cross-fade in place. */
    .nav, .post-title { transition: opacity var(--motion-header-line) ease-out, visibility var(--motion-header-line); }
    .post-title { display: block; grid-area: 1 / 2; justify-self: center; opacity: 0; visibility: hidden; }
    .header[data-titled] .nav { opacity: 0; visibility: hidden; }
    .header[data-titled] .post-title { opacity: 1; visibility: visible; }
    .nav ul { display: flex; gap: var(--rhythm-nav); }
    .contact { display: inline-block; justify-self: end; }
    .menu-toggle, .sheet { display: none; }
  }
  @media (min-width: 48rem) and (prefers-reduced-motion: reduce) {
    .nav, .post-title { transition: none; }
  }
</style>

<script>
  // Mobile menu: open/close instantly. No animation.

  const setOpen = (open: boolean) => {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const sheet = document.querySelector<HTMLElement>('[data-menu]');
    if (!toggle || !sheet) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('[data-label-closed]')?.toggleAttribute('hidden', open);
    toggle.querySelector('[data-label-open]')?.toggleAttribute('hidden', !open);
    document.documentElement.toggleAttribute('data-menu-open', open);
    sheet.hidden = !open;
  };

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-menu-toggle]')) {
      const open = document.querySelector('[data-menu-toggle]')?.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    } else if (target.closest('[data-menu-link]')) {
      setOpen(false);
    }
  });
  // Line under the header only once real content (the first text/image on the page)
  // has slid up beneath it — not merely because the page moved.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const firstContent = document.querySelector<HTMLElement>('main :is(h1, h2, p, img, a, li)');
  const syncCovering = () => {
    if (!header || !firstContent) return;
    const covering = firstContent.getBoundingClientRect().top < header.getBoundingClientRect().bottom;
    header.toggleAttribute('data-covering', covering);
  };
  window.addEventListener('scroll', syncCovering, { passive: true });
  window.addEventListener('resize', syncCovering);
  syncCovering();

  // Blog posts: post title replaces the nav once the big title is under the header; reading progress.
  if (header?.hasAttribute('data-post')) {
    const bigTitle = document.querySelector<HTMLElement>('main h1');
    const article = document.querySelector<HTMLElement>('main .sheet') ?? document.querySelector<HTMLElement>('main');
    const syncPost = () => {
      const height = header.offsetHeight;
      if (bigTitle) header.toggleAttribute('data-titled', bigTitle.getBoundingClientRect().bottom < height);
      // 0 when the article's top reaches the header, 1 when its end reaches the bottom of the screen.
      if (article) {
        const box = article.getBoundingClientRect();
        const span = box.height - window.innerHeight + height;
        const read = span > 0 ? (height - box.top) / span : 1;
        header.style.setProperty('--progress', String(Math.min(1, Math.max(0, read))));
      }
    };
    window.addEventListener('scroll', syncPost, { passive: true });
    window.addEventListener('resize', syncPost);
    syncPost();
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.documentElement.hasAttribute('data-menu-open')) setOpen(false);
  });
</script>
