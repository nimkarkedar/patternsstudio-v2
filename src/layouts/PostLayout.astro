---
// Case-study / blog-post page — Kedar's design "MacBook Air - 38" (2026-11-06; replaces 32):
//   on the blue page: ← Back (to /work, a small ghost pill above the title; Kedar 2026-11-06) → title → PostStory (story cards)
//   → a white sheet with a rounded top, full viewport width: the Markdown body (visuals), exactly in Notion's order
//   (images edge to edge up to 1280) → one button, "Impressed? Let’s talk" (→ /contact; Kedar, 2026-11-01)
//   → back on blue (Kedar 2026-11-09): "Next post" (.t-h2) + the next post's /work row (title + View details | graphic).
//   The /work card graphic isn't shown on the post itself.
//   Arriving from /work, a white cover slides down into the sheet's place (src/scripts/sheet-transition.ts).
//   Floating ↑ (to top) appears once the top × scrolls away; it jumps (no smooth scroll — Motion rules).
// Used by src/pages/work/[slug].astro and by Markdown pages (`layout:` frontmatter, e.g. /styleguide).
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Actions from '../components/Actions.astro';
import Button from '../components/Button.astro';
import PostStory, { type Story } from '../components/PostStory.astro';
import PostCard from '../components/PostCard.astro';
import type { CollectionEntry } from 'astro:content';
import { routes, labels, path } from '../data/site';
import { ids, canonicalFor } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  publishedDate?: Date;
  updatedDate?: Date;
  /** Not shown; goes into the article's structured data (timeRequired). */
  readMinutes?: number;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Story carousel; absent on Markdown pages such as /styleguide. */
  story?: Story;
  noindex?: boolean;
  /** The post after this one in Notion's Order (wraps to the first); shown under the CTA as its /work card. */
  next?: CollectionEntry<'work'>;
  /** False for a post not written yet: no white sheet. */
  hasBody?: boolean;
  /** Present when used as a Markdown page layout. */
  frontmatter?: Omit<Props, 'frontmatter'>;
}
const props = Astro.props.frontmatter ? { ...Astro.props.frontmatter, ...Astro.props } : Astro.props;
const { title, description, readMinutes, ogImage, ogImageAlt, story, next, noindex = false, hasBody = true } = props;
const publishedDate = props.publishedDate ? new Date(props.publishedDate) : undefined;
const updatedDate = props.updatedDate ? new Date(props.updatedDate) : undefined;

const origin = Astro.site ?? new URL(Astro.url.origin);
const url = canonicalFor(Astro.url.pathname, origin);
const id = ids(origin);

const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: title,
    ...(description ? { description } : {}),
    url,
    mainEntityOfPage: url,
    inLanguage: 'en',
    author: { '@id': id.founder },
    publisher: { '@id': id.org },
    isPartOf: { '@id': id.website },
    ...(publishedDate ? { datePublished: publishedDate.toISOString() } : {}),
    ...(updatedDate || publishedDate ? { dateModified: (updatedDate ?? publishedDate)!.toISOString() } : {}),
    ...(readMinutes ? { timeRequired: `PT${readMinutes}M` } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Work', item: new URL(`${routes.workList}/`, origin).href },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={ogImageAlt}
  type="article"
  publishedDate={publishedDate}
  updatedDate={updatedDate}
  noindex={noindex}
  jsonLd={jsonLd}
  postTitle={hasBody ? title : undefined}
>
  <div class="sheet-cover" data-sheet-cover aria-hidden="true" hidden></div>
  <script is:inline>
    // Arriving from /work: show the white cover before the first paint (no flash of blue). It then slides away.
    try { if (sessionStorage.getItem('sheet-cover')) document.querySelector('[data-sheet-cover]').hidden = false; } catch {}
  </script>

  <article class="post">
    <header class="hero container">
      <Button href={routes.workList} variant="ghost" small class="back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 6l-6 6 6 6" />
        </svg>
        {labels.back}
      </Button>
      <h1 class="t-h1 title">{title}</h1>
    </header>

    {story && <div class="story"><PostStory story={story} /></div>}

    <div class="sheet on-surface">
      {hasBody && (
        <div class="prose">
          <slot />
        </div>
      )}

      <div class="end container">
        <Actions primary={{ label: labels.impressedTalk, href: routes.contact }} />
      </div>

    </div>

    {next && (
      <nav class="next container" aria-labelledby="next-post">
        <h2 id="next-post" class="t-h2 next-label">{labels.nextPost}</h2>
        <PostCard post={next} href={routes.work(next.id)} row level={3} />
      </nav>
    )}
  </article>

  <div class="float" data-float hidden>
    <a class="float-button" href="#top" aria-label={labels.toTop} data-to-top>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 15l6-6 6 6" />
      </svg>
    </a>
  </div>
</BaseLayout>

<script>
  import '../scripts/sheet-transition';

  // Floating to-top: shown only while the Back button is out of view.
  const float = document.querySelector<HTMLElement>('[data-float]');
  const topBack = document.querySelector<HTMLElement>('.post .back');
  if (float && topBack) {
    new IntersectionObserver(([entry]) => { float.hidden = entry.isIntersecting; }).observe(topBack);
    float.querySelector('[data-to-top]')?.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0 });
      topBack.focus({ preventScroll: true }); // keyboard users land at the top too
    });
  }
</script>

<style>
  .post {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* The white sheet: full viewport width, rounded top, runs down to the footer. */
  .sheet {
    flex: 1;
    margin-top: var(--rhythm-hero-to-content);
    padding-top: var(--rhythm-hero-to-content);
    padding-bottom: var(--rhythm-section);
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    background: var(--color-surface);
  }


  /* ← Back above the title: left on phones, centred with the title from 48rem (--align-page). */
  .hero {
    display: grid;
    justify-items: var(--align-page);
    gap: var(--rhythm-back-gap);
    padding-top: var(--rhythm-post-hero);
  }
  .hero :global(.back) { gap: var(--rhythm-back-icon); }
  .hero :global(.back svg) { width: var(--size-back-icon); height: var(--size-back-icon); }
  .title { text-align: var(--align-page); }
  .story { margin-top: var(--rhythm-hero-to-content); }
  @media (min-width: 48rem) {
    .title { max-width: var(--width-post-details); }
  }


  /* Next post (Kedar, 2026-11-09): back on the blue page after the white sheet, a section heading
     and the same row as /work (title + View details on the left, graphic on the right). */
  .next {
    display: grid;
    gap: var(--rhythm-heading-below);
    padding-top: var(--rhythm-heading-above);
    padding-bottom: var(--rhythm-section);
  }
  .next-label { text-align: var(--align-page); }

  .end {
    display: grid;
    justify-items: center;
  }
  .prose + .end { margin-top: var(--rhythm-section); }

  /* Floating to-top: bottom-right, same black circle as the top ×. */
  .float {
    position: fixed;
    right: var(--rhythm-gutter);
    bottom: var(--rhythm-float);
    z-index: var(--z-float);
    display: grid;
    gap: var(--rhythm-action-pair);
  }
  .float[hidden] { display: none; }
  .float-button {
    display: grid;
    place-items: center;
    width: var(--size-cue);
    height: var(--size-cue);
    border-radius: var(--radius-pill);
    background: var(--color-button);
    color: var(--color-on-button);
    box-shadow: var(--shadow-raised);
  }
  .float-button:hover { background: var(--color-button-hover); }
  .float-button svg { width: var(--size-cue-icon); height: var(--size-cue-icon); }

</style>
