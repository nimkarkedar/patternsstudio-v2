---
// About (Kedar's design, MacBook Air - 23 + 29 open card, 2026-11-04): hero, team cards, Advisors.
// Every bio is on its card, nothing to click open (Kedar, 2026-11-06). One card per row. Manav removed 2026-11-06.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Actions from '../components/Actions.astro';
import cleartrip from '../assets/companies/cleartrip.png';
import bookmyshow from '../assets/companies/bookmyshow.png';
import jupiter from '../assets/companies/jupiter.png';
import audnco from '../assets/companies/audnco.png';
import styleTheory from '../assets/companies/style-theory.png';
import goldmanSachs from '../assets/companies/goldman-sachs.png';
import google from '../assets/companies/google.svg';
import indeed from '../assets/companies/indeed.svg';
import propertyguru from '../assets/companies/propertyguru.svg';
import TeamCard from '../components/TeamCard.astro';
import { routes, labels, linkedin } from '../data/site';
import kedar from '../assets/about/kedar-nimkar.webp';
import john from '../assets/about/john-pathrose.webp';
import andrew from '../assets/about/andrew-mcglinchey.webp';
import raena from '../assets/about/raena-lim.webp';

// Andrew's bio is Kedar's (MacBook Air - 29). Raena's is shortened from her own, to match the others' length.
const team = [
  {
    name: 'Kedar Nimkar',
    role: 'Co-founder & Principal Designer',
    photo: kedar,
    linkedin: linkedin.kedar,
    alt: 'Kedar Nimkar, smiling, in a black sweater',
    bio: 'Kedar brings 20 years of experience in Design. He has previously led design teams at Cleartrip, PropertyGuru, BookMyShow, Jupiter and Webchutney (later acquired by Dentsu). He is an author of “The Design In Everything” book and host, producer of India’s longest running podcast on Design and Art with over 10M views. He is based in Singapore',
    // PNGs at ~2× (Kedar, 2026-11-10), h = drawn height in logo units; PropertyGuru is the SVG from Andrew's card.
    companies: [{ logo: cleartrip, name: 'Cleartrip', h: 17 }, { logo: bookmyshow, name: 'BookMyShow', h: 24 }, { logo: jupiter, name: 'Jupiter', h: 19 }, { logo: propertyguru, name: 'PropertyGuru' }],
  },
  { name: 'John Pathrose', role: 'Co-founder & Head of Growth', photo: john, linkedin: linkedin.john, alt: 'John Pathrose, smiling, in a dark blazer',
    // Written by Claude from John's LinkedIn (2026-11-10), for Kedar's review. Logos wanted: Microsoft, Intuit, StarHub, Webchutney.
    bio: 'John has spent 20 years taking businesses to market across Asia. He led SMB marketing for Microsoft in APAC, ran Intuit’s channel partner program and launched QuickBooks in new markets, and headed StarHub’s SME business. He began in digital agencies, at Webchutney, DDB and GroupM, and today advises startups on B2B growth.' },
];

const advisors = [
  { name: 'Andrew McGlinchey', role: 'Product', photo: andrew, linkedin: linkedin.andrew, alt: 'Andrew McGlinchey, smiling, in a patterned shirt',
    bio: 'Andrew McGlinchey is a seasoned product leader with extensive experience building and scaling consumer internet products. Former VP of Products at PropertyGuru Group, he has held product leadership roles at Indeed and Google, with earlier experience at Microsoft and muvee Technologies.',
    companies: [{ logo: google, name: 'Google' }, { logo: indeed, name: 'Indeed' }, { logo: propertyguru, name: 'PropertyGuru' }] },
  { name: 'Raena Lim', role: 'Growth', photo: raena, linkedin: linkedin.raena, alt: 'Raena Lim, smiling', bio: 'Raena is a Managing Partner at AUD’NCO, where she advises founders as a fractional COO. She co-founded Style Theory, Southeast Asia’s largest fashion rental platform, and as COO raised ~$30M and scaled it across three markets. She began in community banking in Kenya before joining Goldman Sachs in Asia.',
    // PNGs at 2× (Kedar, 2026-11-09): h = drawn height in SVG-logo units, half the pixel height.
    companies: [{ logo: audnco, name: 'AUD’NCO', h: 16 }, { logo: styleTheory, name: 'Style Theory', h: 15 }, { logo: goldmanSachs, name: 'Goldman Sachs', h: 24 }] },
];
---
<BaseLayout title="About" description="An independent design studio from SEA. A team of seasoned industry professionals. We connect market patterns with the finer details.">
  <Hero
    title={['An independent design', 'studio from SEA']}
    lead="A team of seasoned industry professionals. We connect market patterns with the finer details that help your business grow."
  >
    <Actions primary={{ label: labels.exploreServices, href: routes.services }} />
  </Hero>

  <div class="container page">
    <section class="cards" aria-label="Team">
      {team.map((person) => <TeamCard {...person} />)}
    </section>

    <section aria-labelledby="advisors">
      <h2 id="advisors" class="t-h2 heading">Advisors</h2>
      <div class="cards">
        {advisors.map((person) => <TeamCard {...person} />)}
      </div>
      <div class="actions"><Actions primary={{ label: labels.exploreWork, href: routes.workList }} /></div>
    </section>
  </div>
</BaseLayout>

<style>
  .page { padding-bottom: var(--rhythm-section); }
  /* One card per row, full content width: photo left, bio beside it (TeamCard). */
  .cards { display: grid; gap: var(--rhythm-card-gap); }
  .actions { display: flex; justify-content: center; margin-top: var(--rhythm-page-actions); }
  .heading { text-align: var(--align-page); margin-block: var(--rhythm-heading-above) var(--rhythm-heading-below); }
</style>
