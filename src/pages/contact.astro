---
// Contact (Kedar's design, MacBook Air - 26, 2026-11-04). Phones: the address is one big button for the thumb.
// From 48rem: centred between header and footer, the address an underlined line of its own.
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../data/seo';
import { routes, site, labels } from '../data/site';
import { linkedinPath } from '../icons/linkedin';
---
<BaseLayout {...pageSeo.contact}>
  <section class="contact">
    <h1 class="t-h1">Hello!</h1>
    <p class="t-p lead">The best way to get in touch is to email us at <a class="email" href={routes.email}>{site.email}</a></p>
    <p class="t-p note">We hope you value good design</p>
    {/* Kedar, 2026-11-15: just the LinkedIn mark, no words. */}
    <a class="linkedin" href={site.linkedin} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={linkedinPath} /></svg>
      <span class="visually-hidden">{labels.studioOnLinkedIn} ({labels.newTab})</span>
    </a>
  </section>
</BaseLayout>

<style>
  .contact {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: var(--align-page);
    text-align: var(--align-page);
    padding: var(--rhythm-page-top) var(--rhythm-gutter);
  }
  .lead { margin-top: var(--rhythm-title-to-lead); }
  .email {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--size-button-h);
    margin-top: var(--rhythm-lead-to-actions);
    border-radius: var(--radius-pill);
    background: var(--color-button);
    color: var(--color-on-button);
  }
  .lead { width: 100%; text-wrap: balance; }
  .note { margin-top: var(--rhythm-title-to-lead); color: var(--color-on-page-muted); }
  .linkedin { position: relative; margin-top: var(--rhythm-lead-to-actions); color: var(--color-on-page-muted); }
  .linkedin::after { content: ''; position: absolute; inset: var(--rhythm-hit); } /* thumb-sized tap area */
  .linkedin svg { display: block; width: var(--size-contact-icon); height: var(--size-contact-icon); }
  .linkedin:hover { color: var(--color-on-page); }
  @media (min-width: 48rem) {
    .contact { justify-content: center; }
    .email {
      display: block;
      min-height: 0;
      margin-top: 0;
      border-radius: 0;
      background: none;
      color: inherit;
      text-decoration: underline;
      text-decoration-thickness: var(--underline-width);
      text-underline-offset: var(--underline-offset);
    }
    .email:hover { color: var(--color-on-page-muted); }
    .note { margin-top: var(--rhythm-stack); }
  }
</style>
