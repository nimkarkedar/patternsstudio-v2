---
// All work (was the homepage until Kedar's MacBook Air - 16 redesign, 2026-10-30).
// Cards (Kedar, 2026-11-01): one full-width card per post, stacked, as wide as the Our Way (Hitchcock)
// cards. Each card is just Kedar's graphic at the link-preview ratio and opens its post.
// Header (Kedar, 2026-11-01): only the heading "Work that speaks for itself", then the cards.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PostCard from '../../components/PostCard.astro';
import { routes } from '../../data/site';

const posts = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Work" description="At Patterns, we design software, build brands, and bring products to market. Combining years of design experience with AI.">
  <!-- Kedar 2026-11-01: heading only, then straight into the cards (no lead, buttons or logo strip). -->
  <Hero title="Work that speaks for itself" />

  {posts.length > 0 && (
    <section class="container" aria-label="Work">
      <ul role="list" class="stack">
        {posts.map((post, i) => (
          <li><PostCard post={post} href={routes.work(post.id)} eager={i === 0} /></li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .stack { display: grid; gap: var(--rhythm-card-gap); }
  /* The cards end the page: same space before the footer as between big sections. */
  section { padding-bottom: var(--rhythm-section); }
</style>
