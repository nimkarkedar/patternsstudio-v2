---
// Services (Kedar's design, MacBook Air - 30, 2026-11-04): hero, problem → probable solution table,
// "Traditionally it’s called" + service grid. The frame repeats one service as a placeholder; the six services stay as they were.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Actions from '../components/Actions.astro';
import ProblemList from '../components/ProblemList.astro';
import IconGrid from '../components/IconGrid.astro';
import { routes, labels } from '../data/site';

// Kedar's words, verbatim (typos stay until he fixes them).
const problems = [
  { problem: 'Our product looks like any other product in the market due to AI', solution: 'Design System + Brand Identity' },
  { problem: 'We’ve leaky funnels, slow adoption and low conversion.', solution: 'UI and UX optimisation + Storytelling' },
  { problem: 'We’ve grown too fast. Our product looks in-coherent', solution: 'Design System' },
  { problem: 'Users / Clients are unclear about our offerings', solution: 'Product Marketing + Brand communication + Storytelling' },
  { problem: 'We want to adopt AI and grow.', solution: 'Design Advisory' },
];

const services = [
  { label: 'Brand and communication design', icon: 'brand' },
  { label: 'Product & Experience Design with Prototyping', icon: 'product' },
  { label: 'MVP and GTM Design', icon: 'mvp' },
  { label: 'Growth and design advisory', icon: 'growth' },
  { label: 'AI transformation of your business', icon: 'ai' },
  { label: 'Workshops and elevating teams with C-Suite', icon: 'workshops' },
];
---
<BaseLayout title="Services" description="Different problems. Familiar patterns. We’ve learned to recognise common patterns to grow brands and products.">
  <Hero
    title={['Different problems.', 'Familiar patterns.']}
    lead="We’ve learned to recognise common patterns to grow brands and products. We use design thinking and creativity to solve them."
  >
    <Actions primary={{ label: labels.exploreWork, href: routes.workList }} />
  </Hero>

  <div class="container page">
    <section aria-label="Problems we solve">
      <ProblemList items={problems} problemLabel="Problem / Situation" solutionLabel="Probable solution (we provide)" />
    </section>

    <section aria-labelledby="called">
      <h2 id="called" class="t-h2 heading">Traditionally it’s called</h2>
      <IconGrid set="services" items={services} />
    </section>

    <div class="actions"><Actions primary={{ label: labels.exploreWork, href: routes.workList }} /></div>
  </div>
</BaseLayout>

<style>
  .page { padding-bottom: var(--rhythm-section); }
  .heading { text-align: center; margin-block: var(--rhythm-team-heading); }
  .actions { display: flex; justify-content: center; margin-top: var(--rhythm-team-heading); }
</style>
