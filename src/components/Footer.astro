---
import { site } from '../data/site';
---
<footer class="footer">
  <p class="t-small">
    {site.legal} <span role="img" aria-label="Singapore">{site.flag}</span>
    <span class="dot" aria-hidden="true">·</span> {site.uen}
  </p>
</footer>

<style>
  .footer {
    margin-top: auto;
    margin-inline: var(--rhythm-gutter);
    padding-block: var(--rhythm-footer);
    border-top: var(--line-width) solid var(--color-line-on-page);
    color: var(--color-on-page-muted);
    text-align: var(--align-page);
  }
  .footer p { display: inline-flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; justify-content: var(--align-page); }
  .dot { display: none; } /* phones: the UEN wraps to its own line */
  @media (min-width: 48rem) { .dot { display: inline; } }
</style>
