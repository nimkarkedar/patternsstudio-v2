---
// About (Kedar's design, MacBook Air - 23 + 29 open card, 2026-11-04): hero, team cards, Advisors.
// Every bio is on its card, nothing to click open (Kedar, 2026-11-06). One card per row. Manav removed 2026-11-06.
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../data/seo';
import Hero from '../components/Hero.astro';
import Actions from '../components/Actions.astro';
import cleartrip from '../assets/companies/cleartrip.png';
import bookmyshow from '../assets/companies/bookmyshow.png';
import jupiter from '../assets/companies/jupiter.png';
import audnco from '../assets/companies/audnco.png';
import styleTheory from '../assets/companies/style-theory.png';
import goldmanSachs from '../assets/companies/goldman-sachs.png';
import google from '../assets/companies/google.svg';
import indeed from '../assets/companies/indeed.svg';
import propertyguru from '../assets/companies/propertyguru.svg';
import microsoft from '../assets/companies/microsoft.png';
import starhub from '../assets/companies/starhub.png';
import intuit from '../assets/companies/intuit.png';
import groupm from '../assets/companies/groupm.png';
import TeamCard from '../components/TeamCard.astro';
import { routes, labels, linkedin } from '../data/site';
import kedar from '../assets/about/kedar-nimkar.webp';
import john from '../assets/about/john-pathrose.webp';
import andrew from '../assets/about/andrew-mcglinchey.webp';
import raena from '../assets/about/raena-lim.webp';
import kanika from '../assets/about/kanika-sood.webp';

// Company logos (Kedar, 2026-11-13: "visually and optically the same size"). TeamCard gives every logo the same
// area, so wide wordmarks come out shorter and compact ones taller. `weight` is a small optical nudge
// from Claude's side-by-side check: below 1 for heavy, dense logos, above 1 for light, airy ones.
// Files are trimmed to their ink, with no transparent padding (trim any new logo the same way).
const co = {
  cleartrip: { logo: cleartrip, name: 'Cleartrip' },
  bookmyshow: { logo: bookmyshow, name: 'BookMyShow' },
  jupiter: { logo: jupiter, name: 'Jupiter', weight: 0.92 },
  propertyguru: { logo: propertyguru, name: 'PropertyGuru', weight: 1.08 },
  microsoft: { logo: microsoft, name: 'Microsoft' },
  starhub: { logo: starhub, name: 'StarHub', weight: 1.1 },
  intuit: { logo: intuit, name: 'Intuit', weight: 0.86 },
  groupm: { logo: groupm, name: 'GroupM' },
  google: { logo: google, name: 'Google', weight: 0.95 },
  indeed: { logo: indeed, name: 'Indeed', weight: 0.9 },
  audnco: { logo: audnco, name: 'AUD’NCO' },
  styleTheory: { logo: styleTheory, name: 'Style Theory' },
  goldmanSachs: { logo: goldmanSachs, name: 'Goldman Sachs', weight: 0.94 },
};

// Andrew's bio is Kedar's (MacBook Air - 29). Raena's is shortened from her own, to match the others' length.
const team = [
  {
    name: 'Kedar Nimkar',
    role: 'Co-founder & Principal Designer',
    photo: kedar,
    linkedin: linkedin.kedar,
    alt: 'Kedar Nimkar, smiling, in a black sweater',
    // Kedar's words (2026-11-15), cut to Andrew's length (Kedar, 2026-11-16).
    bio: 'Kedar is a Singapore-based design leader with 20 years of experience building digital products used by millions across Asia. He has led design at PropertyGuru, Jupiter, BookMyShow and Cleartrip, turning complex consumer problems into intuitive products. He is the author of The Design in Everything and host of India’s longest-running design and art podcast, with over 10 million views.',
    companies: [co.propertyguru, co.jupiter, co.bookmyshow, co.cleartrip], // same order as the bio
  },
  { name: 'John Pathrose', role: 'Co-founder & Head of Growth', photo: john, linkedin: linkedin.john, alt: 'John Pathrose, smiling, in a dark blazer',
    // Kedar's words (2026-11-15), cut to Andrew's length (Kedar, 2026-11-16). Logos from Kedar 2026-11-13.
    bio: 'John is a Singapore-based growth leader with two decades of experience across marketing, sales, media and go-to-market strategy in Asia Pacific. He has held senior leadership roles at Microsoft, StarHub and Intuit, driving market expansion, customer acquisition and growth, with deep expertise in the SMB segment. He also consults for scale-ups, connecting brand positioning, commercial strategy and go-to-market execution.',
    companies: [co.microsoft, co.starhub, co.intuit, co.groupm] },
];

const advisors = [
  { name: 'Andrew McGlinchey', role: 'Product', photo: andrew, linkedin: linkedin.andrew, alt: 'Andrew McGlinchey, smiling, in a patterned shirt',
    bio: 'Andrew McGlinchey is a seasoned product leader with extensive experience building and scaling consumer internet products. Former VP of Products at PropertyGuru Group, he has held product leadership roles at Indeed and Google, with earlier experience at Microsoft and muvee Technologies.',
    companies: [co.google, co.indeed, co.propertyguru] },
  { name: 'Raena Lim', role: 'Growth', photo: raena, linkedin: linkedin.raena, alt: 'Raena Lim, smiling', bio: 'Raena is a Managing Partner at AUD’NCO, where she advises founders as a fractional COO. She co-founded Style Theory, Southeast Asia’s largest fashion rental platform, and as COO raised ~$30M and scaled it across three markets. She began in community banking in Kenya before joining Goldman Sachs in Asia.',
    companies: [co.audnco, co.styleTheory, co.goldmanSachs] },
  // Kedar's words (2026-11-16), cut to Andrew's length (Kedar, 2026-11-16). Portrait: Kedar's cut-out on white, eyes level with Raena's. TODO(Kedar): Cadbury, Adobe, Standard Chartered logos.
  { name: 'Kanika Sood', role: 'Brand & Creative', photo: kanika, linkedin: linkedin.kanika, alt: 'Kanika Sood, smiling, in a white embroidered top',
    companies: [co.google],
    bio: 'Kanika is a brand and business leader with 18+ years of experience across strategy, creativity and commercial growth. Across agency and in-house leadership roles, she has partnered with Google, Cadbury, Samsung, Microsoft and Standard Chartered, leading regional marketing and integrated campaigns across APAC. A Cannes Lions Gold and APAC Effies winner, she believes great marketing should move both people and business.' },
];
---
<BaseLayout {...pageSeo.about}>
  <Hero
    title={['An independent design studio', 'based in Southeast Asia']}
    lead="A team of seasoned industry professionals. We bring together decades of reliable experience in design, product, brand and business growth."
  >
    <Actions primary={{ label: labels.exploreServices, href: routes.services }} />
  </Hero>

  <div class="container page">
    <section class="cards" aria-label="Team">
      {team.map((person) => <TeamCard {...person} />)}
    </section>

    <section aria-labelledby="advisors">
      <h2 id="advisors" class="t-h2 heading">Advisors</h2>
      <div class="cards">
        {advisors.map((person) => <TeamCard {...person} />)}
      </div>
      <div class="actions"><Actions primary={{ label: labels.exploreWork, href: routes.workList }} /></div>
    </section>
  </div>
</BaseLayout>

<style>
  .page { padding-bottom: var(--rhythm-section); }
  /* One card per row, full content width: photo left, bio beside it (TeamCard). */
  .cards { display: grid; gap: var(--rhythm-card-gap); }
  .actions { display: flex; justify-content: center; margin-top: var(--rhythm-page-actions); }
  .heading { text-align: var(--align-page); margin-block: var(--rhythm-heading-above) var(--rhythm-heading-below); }
</style>
