---
// /reviews: grid of every client logo (Kedar, 2026-10-30). Static — no motion.
// Logo files are white on page-blue tiles (400 × 150, padding built in), so they sit straight on the page, no card.
// 4 per row ≥48rem, 2 on phones. Hairlines between logos only, never on the outer edges (Kedar, 2026-10-30):
// each cell draws its left + top line, and the wrapper clips the first column's left and first row's top.
// Names render as text until a file exists.
// Same files + list as the scrolling strip on /work (ClientLogos): src/assets/clients/<file>, `clients` in site.ts.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { clients } from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/clients/*.{svg,png,webp}', { eager: true });
const logoFor = (file: string) =>
  Object.entries(files).find(([path]) => path.split('/').pop()?.replace(/\.\w+$/, '') === file)?.[1].default;
---
<section class="logos" aria-label="Clients">
  <div class="clip">
    <ul role="list" class="grid">
      {clients.map((c) => {
        const logo = logoFor(c.file);
        return (
          <li class="item">
            {logo
              ? <Image src={logo} alt={c.name} class="logo" widths={[240, 480]} sizes="(min-width: 48rem) 200px, 45vw" />
              : <span class="t-body-strong">{c.name}</span>}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .clip { overflow: hidden; }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: calc(-1 * var(--line-width)) 0 0 calc(-1 * var(--line-width)); /* hides the outer left + top lines */
  }
  .item {
    display: grid;
    place-items: center;
    padding: var(--rhythm-logo-grid-cell);
    border-left: var(--line-width) solid var(--color-line-on-page);
    border-top: var(--line-width) solid var(--color-line-on-page);
    color: var(--color-on-page);
    text-align: center;
  }
  .logo { width: 100%; max-width: var(--width-client-logo-grid); height: auto; }

  @media (min-width: 48rem) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
