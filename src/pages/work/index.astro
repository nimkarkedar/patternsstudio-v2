---
// All work (Kedar's design, MacBook Air - 31, 2026-11-04): heading, then one full-width card per post, stacked.
// Each card is Kedar's graphic at the link-preview ratio and opens its post.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PostCard from '../../components/PostCard.astro';
import { routes } from '../../data/site';

const posts = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Work" description="Doing good work. Case studies from Patterns Studio across brand, communication, product design and strategic growth advisory.">
  <Hero title="Doing good work" />

  {posts.length > 0 && (
    <section class="container" aria-label="Work">
      <ul role="list" class="stack">
        {posts.map((post, i) => (
          <li><PostCard post={post} href={routes.work(post.id)} eager={i === 0} row /></li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<script>
  import '../../scripts/sheet-transition';
</script>

<style>
  .stack { display: grid; gap: var(--rhythm-work-card); }
  /* The cards end the page: same space before the footer as between big sections. */
  section { padding-bottom: var(--rhythm-section); }
</style>
