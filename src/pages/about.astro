---
// About (Kedar's design, MacBook Air - 23 + 29 open card, 2026-11-04): hero, team cards, Advisors.
// Every bio is on its card, nothing to click open (Kedar, 2026-11-06). One card per row. Manav removed 2026-11-06.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Actions from '../components/Actions.astro';
import TeamCard from '../components/TeamCard.astro';
import { routes, labels, linkedin } from '../data/site';
import kedar from '../assets/about/kedar-nimkar.webp';
import john from '../assets/about/john-pathrose.webp';
import andrew from '../assets/about/andrew-mcglinchey.webp';
import raena from '../assets/about/raena-lim.webp';

// TODO(Kedar): John's bio.
// Andrew's bio is Kedar's (MacBook Air - 29). Raena's is shortened from her own, to match the others' length.
const team = [
  {
    name: 'Kedar Nimkar',
    role: 'Designer',
    photo: kedar,
    linkedin: linkedin.kedar,
    alt: 'Kedar Nimkar, smiling, in a black sweater',
    bio: 'Kedar brings 20 years of experience in Design. He has previously led design teams at Cleartrip, PropertyGuru, BookMyShow, Jupiter and Webchutney (later acquired by Dentsu). He is an author of “The Design In Everything” book and host, producer of India’s longest running podcast on Design and Art with over 10M views. He is based in Singapore',
  },
  { name: 'John Pathrose', role: 'Storyteller', photo: john, linkedin: linkedin.john, alt: 'John Pathrose, smiling, in a dark blazer', bio: 'TODO(Kedar): John’s short bio.' },
];

const advisors = [
  { name: 'Andrew McGlinchey', role: 'Product', photo: andrew, linkedin: linkedin.andrew, alt: 'Andrew McGlinchey, smiling, in a patterned shirt',
    bio: 'Andrew McGlinchey is a seasoned product leader with extensive experience building and scaling consumer internet products. Former VP of Products at PropertyGuru Group, he has held product leadership roles at Indeed and Google, with earlier experience at Microsoft and muvee Technologies.' },
  { name: 'Raena Lim', role: 'Finance', photo: raena, linkedin: linkedin.raena, alt: 'Raena Lim, smiling', bio: 'Raena is a Managing Partner at AUD’NCO, where she advises founders as a fractional COO. She co-founded Style Theory, Southeast Asia’s largest fashion rental platform, and as COO raised ~$30M and scaled it across three markets. She began in community banking in Kenya before joining Goldman Sachs in Asia.' },
];
---
<BaseLayout title="About" description="An independent design studio based in Asia. A team of seasoned industry professionals. We connect market patterns with the finer details.">
  <Hero
    title={['An independent design', 'studio based in Asia']}
    lead="A team of seasoned industry professionals. We connect market patterns with the finer details that help your business grow."
  >
    <Actions primary={{ label: labels.exploreServices, href: routes.services }} />
  </Hero>

  <div class="container page">
    <section class="cards" aria-label="Team">
      {team.map((person) => <TeamCard {...person} />)}
    </section>

    <section aria-labelledby="advisors">
      <h2 id="advisors" class="t-h2 heading">Advisors</h2>
      <div class="cards">
        {advisors.map((person) => <TeamCard {...person} />)}
      </div>
      <div class="actions"><Actions primary={{ label: labels.exploreWork, href: routes.workList }} /></div>
    </section>
  </div>
</BaseLayout>

<style>
  .page { padding-bottom: var(--rhythm-section); }
  /* One card per row, full content width: photo left, bio beside it (TeamCard). */
  .cards { display: grid; gap: var(--rhythm-card-gap); }
  .actions { display: flex; justify-content: center; margin-top: var(--rhythm-page-actions); }
  .heading { text-align: var(--align-page); margin-block: var(--rhythm-heading-above) var(--rhythm-heading-below); }
</style>
