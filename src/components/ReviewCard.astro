---
// One client review card (Kedar's design, MacBook Air - 22 + 27, 2026-11-04): on white, the quote (P, a fixed
// number of lines tall so every name lines up), name (P-Bold), role (Small-P, grey), then the portrait, cropped by the card's bottom edge.
// Used by the homepage strip and /reviews. Portraits: src/assets/reviews/<file>.webp, cropped from the frame.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { reviews } from '../data/site';

interface Props { review: (typeof reviews)[number] }
const { review } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/reviews/*.{png,jpg,webp}', { eager: true });
const photo = Object.entries(files).find(([path]) => path.split('/').pop()?.replace(/\.\w+$/, '') === review.file)?.[1].default;
---
<figure class="card" data-tilt>
  <blockquote class="t-p quote"><p>{review.quote}</p></blockquote>
  <figcaption class="person">
    <span class="t-p-bold">{review.name}</span>
    <span class="t-small role">{review.role}</span>
  </figcaption>
  {/* Eager: in the homepage strip they move in by scrolling script, which can miss lazy-loading. */}
  {photo && <Image src={photo} alt="" class="photo" loading="eager" widths={[400, 800, 1023]} sizes="(min-width: 48rem) 352px, 80vw" />}
</figure>

<script>
  import '../scripts/tilt';
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-on-surface);
    box-shadow: var(--shadow-glow);
  }
  .quote {
    min-height: calc(var(--lines-review-quote) * 1lh + var(--rhythm-card-pad));
    padding: var(--rhythm-card-pad) var(--rhythm-card-pad) 0;
  }
  .person {
    display: grid;
    gap: var(--rhythm-label);
    padding: var(--rhythm-review-name) var(--rhythm-card-pad);
  }
  .role { color: var(--color-on-surface-muted); }
  .photo { width: 100%; height: auto; aspect-ratio: var(--ratio-review-photo); object-fit: cover; object-position: var(--position-review-photo); margin-top: auto; }
</style>
