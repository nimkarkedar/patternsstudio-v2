---
// About (Kedar's design, MacBook Air - 17 + 18 open card, 2026-10-30): hero, team cards, Advisors.
// Clicking a card flips it in 3D to a short bio (TeamCard). No tilt on this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Actions from '../components/Actions.astro';
import Button from '../components/Button.astro';
import TeamCard from '../components/TeamCard.astro';
import { routes, labels, reviews } from '../data/site';
import kedar from '../assets/about/kedar-nimkar.png';
import john from '../assets/about/john-pathrose.png';
import andrew from '../assets/reviews/andrew-mcglinchey.png';
import audrey from '../assets/reviews/audrey-woo.png';
import jeremy from '../assets/reviews/jeremy-williams.png';
import manav from '../assets/reviews/manav-kamboj.png';

// TODO(Kedar): LinkedIn URLs (the mark becomes a link once `linkedin` is set); John's + Audrey's bios;
// 2× photos of Audrey, Jeremy + Manav (380 wide now).
// Andrew's, Jeremy's + Manav's bios are drafts from public sources (2026-10-30) — each person to approve before launch.
const team = [
  {
    name: 'Kedar Nimkar',
    role: 'Principal at Patterns Studio',
    photo: kedar,
    alt: 'Kedar Nimkar, smiling, in a black sweater',
    bio: 'Kedar brings 20 years of experience in Design. He has previously led design teams at Cleartrip, PropertyGuru, BookMyShow, Jupiter and Webchutney (later acquired by Dentsu). He is an author of “The Design In Everything” book and host, producer of India’s longest running podcast on Design and Art with over 10M views. He is based in Singapore',
  },
  { name: 'John Pathrose', role: 'Principal at Patterns Studio', photo: john, alt: 'John Pathrose, smiling, in a white shirt', bio: 'TODO(Kedar): John’s short bio.' },
];

// Advisors' roles come from their client reviews (Kedar, 2026-10-30), so the two stay in step.
const reviewRole = (name: string) => reviews.find((r) => r.name === name)!.role;

const advisors = [
  { name: 'Andrew McGlinchey', role: reviewRole('Andrew McGlinchey'), photo: andrew, alt: 'Andrew McGlinchey, smiling, in a patterned shirt',
    bio: 'Andrew is a product leader with a long career in consumer internet. He was VP of Products at PropertyGuru Group in Singapore. Before that he was Director of Product Management at Indeed and a Senior Product Manager at Google, with earlier roles at Microsoft and muvee Technologies.' },
  { name: 'Audrey Woo', role: reviewRole('Audrey Woo'), photo: audrey, alt: 'Audrey Woo', bio: 'TODO(Kedar): Audrey’s short bio.' },
  { name: 'Jeremy Williams', role: reviewRole('Jeremy Williams'), photo: jeremy, alt: 'Jeremy Williams',
    bio: 'Jeremy has run the finances and operations of online marketplaces in Asia. He was Chief Operating Officer and then Managing Director of Marketplaces at PropertyGuru Group in Singapore. Before that he was Group CFO of CarTrade Tech in India, the company behind CarWale.' },
  { name: 'Manav Kamboj', role: reviewRole('Manav Kamboj'), photo: manav, photoAlign: 'right' as const, alt: 'Manav Kamboj',
    bio: 'Manav is a technology leader and founder. He joined PropertyGuru Group as Chief Technology Officer in 2017, doubled its technology team and went on to also lead its fintech business as Managing Director. Earlier he was VP of Technology at Snapdeal and founded the mobile studio Letsgomo Labs. He studied at IIT Roorkee.' },
];
---
<BaseLayout title="About" description="An independent design studio based in Singapore. Led by experienced seasoned professionals from the industry.">
  <Hero
    title="An independent design studio based in Singapore"
    lead="Led by experienced seasoned professionals from the industry. Mature enough to see the macro patterns and agile enough to roll their sleeves to get the craft right."
    bigLead
  />

  <div class="container page">
    <section aria-label="Team">
      <div class="grid">
        {team.map((person) => <TeamCard {...person} />)}
      </div>
      <div class="actions"><Actions primary={{ label: labels.exploreWhatWeDo, href: routes.services }} /></div>
    </section>

    <section aria-labelledby="advisors">
      <h2 id="advisors" class="t-display heading">Advisors</h2>
      <div class="grid">
        {advisors.map((person) => <TeamCard {...person} />)}
      </div>
      <div class="actions"><Button href={routes.wow} variant="ghost">{labels.exploreOurWow}</Button></div>
    </section>
  </div>
</BaseLayout>

<style>
  .page { padding-bottom: var(--rhythm-section); }
  .grid { display: grid; gap: var(--rhythm-card-gap); align-items: start; }
  .actions { display: flex; justify-content: center; margin-top: var(--rhythm-team-actions); }
  .heading { text-align: center; margin-block: var(--rhythm-team-heading); }

  @media (min-width: 48rem) {
    .grid { grid-template-columns: 1fr 1fr; align-items: stretch; }
  }
</style>
