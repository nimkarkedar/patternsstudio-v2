---
// All client reviews (nav "Reviews"; Kedar's design, MacBook Air - 33, 2026-11-04): hero, every review card,
// then "We’ve worked with wide range of industries" + every client logo, "Explore our work".
// Kedar 2026-11-11: all cards on top, logos at the end (the frame's second block of cards under the logos is gone).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Actions from '../components/Actions.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ClientLogoGrid from '../components/ClientLogoGrid.astro';
import { reviews, labels, routes } from '../data/site';
---
<BaseLayout title={labels.reviewsTitle} description="How do you become successful? Make people happy. Client reviews of Patterns Studio, and the wide range of industries we’ve worked with.">
  <Hero title={['How do you', 'become successful?']} lead="Make people happy." />

  <div class="container page">
    <section aria-label={labels.reviewsTitle}>
      <ul role="list" class="grid">
        {reviews.map((r) => <li><ReviewCard review={r} /></li>)}
      </ul>
    </section>

    <section aria-labelledby="industries">
      <h2 id="industries" class="t-h2 heading">We’ve worked with <br />wide range of industries</h2>
      <ClientLogoGrid />
    </section>

    <div class="actions"><Actions primary={{ label: labels.exploreWork, href: routes.workList }} /></div>
  </div>
</BaseLayout>

<style>
  .page { padding-bottom: var(--rhythm-section); }
  .grid { display: grid; gap: var(--rhythm-card-gap); }
  .heading { text-align: var(--align-page); margin-block: var(--rhythm-heading-above) var(--rhythm-heading-below); }
  .heading br { display: none; }
  .actions { margin-top: var(--rhythm-page-actions); display: flex; justify-content: center; }
  @media (min-width: 48rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .heading br { display: inline; }
  }
  @media (min-width: 64rem) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
