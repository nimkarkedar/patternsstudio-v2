---
// All client reviews (nav "Reviews"; Kedar's design, MacBook Air - 33, 2026-11-04): hero, six review cards,
// "We’ve worked with wide range of industries" + every client logo, more review cards, "Explore our work".
// The frame's lower block repeats three cards as placeholders, so it stays empty until there are more than six reviews.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Actions from '../components/Actions.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ClientLogoGrid from '../components/ClientLogoGrid.astro';
import { reviews, labels, routes } from '../data/site';

const FIRST = 6; // cards above the logos
const blocks = [reviews.slice(0, FIRST), reviews.slice(FIRST)];
---
<BaseLayout title={labels.reviewsTitle} description="How do you become successful? Make people happy. Client reviews of Patterns Studio, and the wide range of industries we’ve worked with.">
  <Hero title={['How do you', 'become successful?']} lead="Make people happy." />

  <div class="container page">
    <section aria-label={labels.reviewsTitle}>
      <ul role="list" class="grid">
        {blocks[0].map((r) => <li><ReviewCard review={r} /></li>)}
      </ul>
    </section>

    <section aria-labelledby="industries">
      <h2 id="industries" class="t-h2 heading">We’ve worked with <br />wide range of industries</h2>
      <ClientLogoGrid />
    </section>

    {blocks[1].length > 0 && (
      <section class="more" aria-label={labels.reviewsTitle}>
        <ul role="list" class="grid">
          {blocks[1].map((r) => <li><ReviewCard review={r} /></li>)}
        </ul>
      </section>
    )}

    <div class="actions"><Actions primary={{ label: labels.exploreWork, href: routes.workList }} /></div>
  </div>
</BaseLayout>

<style>
  .page { padding-bottom: var(--rhythm-section); }
  .grid { display: grid; gap: var(--rhythm-card-gap); }
  .heading { text-align: center; margin-block: var(--rhythm-team-heading); }
  .heading br { display: none; }
  .more, .actions { margin-top: var(--rhythm-team-heading); }
  .actions { display: flex; justify-content: center; }
  @media (min-width: 48rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .heading br { display: inline; }
  }
  @media (min-width: 64rem) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
