---
// All client reviews (nav "Reviews", homepage "See all client reviews →"). No design yet — the same
// every client logo, then the same cards as the homepage strip, in a grid. TODO(Kedar): design for this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ClientLogoGrid from '../components/ClientLogoGrid.astro';
import { clientReviews as reviews, labels } from '../data/site';

// Meta description = the reviewers' own words.
const description = reviews.slice(0, 3).map((r) => `“${r.quote}” — ${r.name}, ${r.role}.`).join(' ');
---
<BaseLayout title={labels.reviewsTitle} description={description}>
  {/* Kedar's headline, 2026-10-30. Tab title + section label stay "Client reviews". */}
  <Hero title="We don’t like blowing our own trumpet. But how else can we explain?" />

  <div class="container clients">
    <ClientLogoGrid />
  </div>

  <section class="container" aria-label={labels.reviewsTitle}>
    <ul role="list" class="grid">
      {reviews.map((r) => <li><ReviewCard review={r} /></li>)}
    </ul>
  </section>

</BaseLayout>

<style>
  .container { padding-bottom: var(--rhythm-section); }
  .clients { padding-bottom: var(--rhythm-hero-to-content); } /* logos → review cards */
  .grid { display: grid; gap: var(--rhythm-card-gap); }
  @media (min-width: 48rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
