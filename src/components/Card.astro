---
// White surface card. With `href` the whole card is one link (homepage posts) and gets the
// raised hover shadow. Without `href` it's a plain surface (e.g. WOW page).
// `tilt` makes the card lean in 3D toward the mouse (src/scripts/tilt.ts) — every card except /work (Kedar, 2026-10-30).
interface Props { href?: string; class?: string; tilt?: boolean }
const { href, class: className, tilt = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['card', 'on-surface', { 'is-link': href }, className]} href={href} data-tilt={tilt ? '' : undefined}>
  <slot />
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    color: var(--color-on-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-glow);
    transform: perspective(var(--motion-tilt-depth)) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition:
      transform var(--motion-card-raise) ease-out,
      box-shadow var(--motion-card-raise) ease-out;
  }
  .is-link:hover { box-shadow: var(--shadow-glow), var(--shadow-raised); }
</style>

<script>
  import '../scripts/tilt';
</script>
