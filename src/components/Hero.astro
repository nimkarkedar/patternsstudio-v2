---
// Page hero: big display title, optional lead, optional actions (pass <Actions> in the slot).
// `title` and `lead` can be a list of lines — each new line starts after a line break.
// `bigLead` sets the lead in .t-lead (30) instead of .t-body — homepage only.
// A `lead` slot replaces the `lead` prop when the lead needs markup (homepage word swap).
interface Props { title: string | string[]; lead?: string | string[]; bigLead?: boolean }
const { title, lead, bigLead = false } = Astro.props;
const titleLines = Array.isArray(title) ? title : [title];
const leadLines = lead === undefined ? [] : Array.isArray(lead) ? lead : [lead];
const hasLeadSlot = Astro.slots.has('lead');
---
<section class="hero">
  <h1 class="t-display title">{titleLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
  {(hasLeadSlot || leadLines.length > 0) && (
    <p class:list={[bigLead ? 't-lead' : 't-body', 'lead']}>
      {hasLeadSlot ? <slot name="lead" /> : leadLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </p>
  )}
  {Astro.slots.has('default') && <div class="actions"><slot /></div>}
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-inline: var(--rhythm-gutter);
    padding-top: var(--rhythm-page-top);
    padding-bottom: var(--rhythm-hero-to-content);
  }
  .title { max-width: var(--width-hero); }
  .lead { max-width: var(--width-lead); margin-top: var(--rhythm-title-to-lead); }
  .actions {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--rhythm-lead-to-actions);
  }
</style>
