---
// Contact (Kedar's design, MacBook Air - 26, 2026-11-04). Centred between header and footer.
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, site } from '../data/site';
---
<BaseLayout title="Contact" description={`Hello! Best way to get in touch is, email us at ${site.email}. We hope you value good design.`}>
  <section class="contact">
    <h1 class="t-h1">Hello!</h1>
    <p class="t-large lead">Best way to get in touch is, email us at<br /><a class="email" href={routes.email}>{site.email}</a></p>
    <p class="t-p note">We hope you value good design</p>
  </section>
</BaseLayout>

<style>
  .contact {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--rhythm-page-top) var(--rhythm-gutter);
  }
  .lead { margin-top: var(--rhythm-title-to-lead); }
  .email {
    text-decoration: underline;
    text-decoration-thickness: var(--underline-width);
    text-underline-offset: var(--underline-offset);
  }
  .email:hover { color: var(--color-on-page-muted); }
  .note { margin-top: var(--rhythm-stack); color: var(--color-on-page-muted); }
</style>
